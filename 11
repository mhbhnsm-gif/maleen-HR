const STORAGE_KEY = 'malinEmployees_v1';
let rawEmployees = [];

/* ---------- load/save ---------- */
function loadData() {
  const raw = localStorage.getItem(STORAGE_KEY);
  if (!raw) {
    rawEmployees = INITIAL_EMPLOYEES.slice();
    saveData();
    return;
  }
  try {
    const parsed = JSON.parse(raw);
    if (Array.isArray(parsed) && parsed.length) rawEmployees = parsed;
    else rawEmployees = INITIAL_EMPLOYEES.slice();
  } catch (e) {
    console.warn('خطأ بقراءة localStorage، إعادة تعيين للبيانات الأولية');
    rawEmployees = INITIAL_EMPLOYEES.slice();
    saveData();
  }
}
function saveData() { localStorage.setItem(STORAGE_KEY, JSON.stringify(rawEmployees)); }

/* ---------- helpers ---------- */
function unique(arr){ return Array.from(new Set(arr)) }
function groupBy(arr, fn){ return arr.reduce((acc,x)=>{const k=fn(x); (acc[k]=acc[k]||[]).push(x); return acc},{}) }
function escapeHtml(s){ return String(s||'').replace(/[&<>\\]/g,''); }
function openTab(tabName) { /* Tab function */ }

</script>
